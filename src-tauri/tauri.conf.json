{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-json-editor",
  "version": "0.1.2",
  "identifier": "com.dimitarklaturov.claudejsoneditor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "claude.json",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Editor for ~/.claude.json",
    "longDescription": "GUI editor for the Claude Code configuration file at ~/.claude.json."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bulgariamitko/claude-json-editor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEODkwRDQ4OEE1OUVCQTcKUldTbjYxbUtTQTJKcmMwUTQ1WitnUWMyUGFQMHZpNm9ySGp5d2xhQzlMRjI1a0huN1lWcGNkMGQK"
    }
  }
}
